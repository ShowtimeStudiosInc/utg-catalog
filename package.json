{
  "name": "cataloger",
  "version": "0.1.3",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "prisma migrate deploy && next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:prepare": "prisma generate && next build",
    "electron:build": "npm run electron:prepare && electron-builder --publish never",
    "electron:build:win": "npm run electron:prepare && electron-builder --win --publish never",
    "electron:build:mac": "npm run electron:prepare && electron-builder --mac --publish never",
    "electron:build:linux": "npm run electron:prepare && electron-builder --linux --publish never",
    "electron:release:win": "npm run electron:prepare && electron-builder --win --publish always"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "reactflow": "^11.11.4",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.cataloger.rpmanager",
    "productName": "UTG Catalog",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "server-entry.js",
      "next.config.ts",
      "package.json",
      ".next/**/*",
      "public/**/*",
      "src/generated/prisma/**/*",
      "prisma/schema.prisma",
      "prisma/migrations/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/@prisma/engines/**"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage"
    }
  }
}
